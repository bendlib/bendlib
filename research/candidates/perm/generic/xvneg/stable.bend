import Base
import ./m1/p.bend as P1
import ./m2/p.bend as P2

def cross_perm(-A: Data, xs: List<&2, A>, ys: List<&2, A>, h: P1.perm(A, xs, ys)) -> P2.perm(A, xs, ys):
  h

def cross_Perm(-A: Data, s: List<&2, Nat>, xs: List<&2, A>, ys: List<&2, A>, h: P1.Perm(A, s, xs, ys)) -> P2.Perm(A, s, xs, ys):
  h
